{
  "spec_version": "0.1.0",
  "description": "Malformed or out-of-scope inputs and the required error codes.",
  "cases": [
    {
      "id": "invalid-001",
      "description": "Empty input",
      "raw_input": "",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
      "id": "invalid-002",
      "description": "Not JSON",
      "raw_input": "ROSSI MARIO",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
      "id": "invalid-003",
      "description": "Truncated JSON object",
      "raw_input": "{\"surname\":\"ROSSI\",\"name\":\"MARIO\"",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
      "id": "invalid-004",
      "description": "JSON array instead of object",
      "raw_input": "[\"ROSSI\",\"MARIO\",\"1980-01-01\",\"M\",\"H501\"]",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
      "id": "invalid-005",
      "description": "JSON string instead of object",
      "raw_input": "\"RSSMRA80A01H501U\"",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
      "id": "invalid-006",
      "description": "JSON null",
      "raw_input": "null",
      "expected": {
        "error": "invalid_json"
      }
    },
    {
