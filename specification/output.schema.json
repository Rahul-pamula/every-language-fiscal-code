{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openapi/every-language-fiscal-code/specification/output.schema.json",
  "title": "Fiscal code output",
  "description": "Object written on stdout by every implementation (specification 0.1.0).",
  "oneOf": [
    {
      "type": "object",
      "required": ["fiscal_code"],
      "additionalProperties": false,
      "properties": {
        "fiscal_code": { "type": "string", "pattern": "^[A-Z]{6}[0-9]{2}[ABCDEHLMPRST][0-9]{2}[A-Z][0-9]{3}[A-Z]$" }
      }
    },
    {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "enum": [
            "invalid_json",
            "missing_field",
            "invalid_surname",
            "invalid_name",
            "invalid_birth_date",
            "invalid_sex",
            "invalid_birthplace_code"
          ]
        }
      }
    }
  ]
}
